{
  "uid": "pca-overview",
  "title": "PCA Lab — RED + USE overview",
  "description": "Rate / Errors / Duration for the sample app, plus host CPU and memory. Built by hand so every panel query is one I have to be able to write for the exam.",
  "tags": ["pca", "lab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(app_requests_total, job)",
        "refresh": 1,
        "includeAll": true,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate — requests/sec by route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(app_requests_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors — 5xx ratio",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(app_requests_total{job=~\"$job\", status=~\"5..\"}[$__rate_interval])) / sum(rate(app_requests_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "error ratio"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duration — p50 / p95 / p99 from the histogram",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(app_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(app_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(app_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "USE — host CPU and memory utilisation",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "instance:node_cpu_utilisation:ratio5m",
          "legendFormat": "cpu {{instance}}"
        },
        {
          "refId": "B",
          "expr": "instance:node_memory_utilisation:ratio",
          "legendFormat": "memory {{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Targets up",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "count(up == 1)", "legendFormat": "up" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Targets down",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "count(up == 0) or vector(0)", "legendFormat": "down" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Blackbox probe duration",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}
